{
  "mcpServers": {
    "customer-operations-protected": {
      "command": "agentguard",
      "args": [
        "mcp-proxy",
        "--server-id",
        "customer-operations",
        "--",
        "python",
        "customer_operations_server.py"
      ]
    },
    "customer-operations-direct": {
      "command": "python",
      "args": ["customer_operations_server.py"]
    }
  }
}
