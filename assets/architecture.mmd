%% AgentGuard execution-integrity boundary (reference kernel scope).
%% Render with any Mermaid viewer. Educational subset; private core not shown.
flowchart LR
    Proposal[Agent proposal] --> Policy{Policy evaluation}
    Policy -- deny --> Denied[Denied: no receipt]
    Policy -- require_approval --> Approval[Human approval queue]
    Policy -- allow --> Receipt[Signed decision receipt<br/>action + args digest + ceilings + TTL]
    Receipt --> Gate{execute_protected gate}
    Gate -- invalid signature --> Block1[Block: invalid_signature]
    Gate -- expired --> Block2[Block: receipt_expired]
    Gate -- args mutated --> Block3[Block: digest_mismatch]
    Gate -- credential wider --> Block4[Block: credential domination]
    Gate -- already used --> Block5[Block: replayed]
    Gate -- all checks pass --> Exec[Executor: single side effect]
    Credential[Credential <= receipt<br/>audience, ceiling, TTL] -. dominates .-> Gate
